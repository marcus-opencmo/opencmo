# Transcripts — ElevenLabs Scribe (speech-to-text with word timestamps).
# Get a key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Moment selection (Claude Haiku, ~$0.02 per video) and output moderation of AI images/video.
# Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# AI images/video/voice/sound through fal.ai (models with `provider: fal` in ai-models.json),
# and fal's image safety check used by output moderation. Without FAL_KEY and ANTHROPIC_API_KEY
# the worker skips output moderation; the web turns AI images/video off in production.
FAL_KEY=

# --- Tùy chọn ---
# Claude model for moment selection. Empty uses claude-haiku-4-5.
# OPENCMO_SELECT_MODEL=claude-haiku-4-5
# Speech-to-text model. Empty uses scribe_v1.
# OPENCMO_SCRIBE_MODEL=scribe_v1

# Model bám mặt. Bỏ trống thì lần chạy đầu tự tải về ~/.cache/opencmo/.
# Trỏ tới file có sẵn khi build image cho worker, để khỏi tải lại mỗi lần chạy.
# OPENCMO_FACE_MODEL=/root/models/blaze_face_short_range.tflite

# Ép dùng một encoder cụ thể. Bỏ trống để engine tự dò bằng test-encode thật.
# OPENCMO_ENCODER=h264_qsv
# OPENCMO_VAAPI_DEVICE=/dev/dri/renderD128

# Số job render song song. Mặc định = nửa số core.
# Đây cũng là cái chốt giữ RAM: mỗi tiến trình ffmpeg ~400MB.
# OPENCMO_MAX_PARALLEL=2

# --- Proxy cho yt-dlp (YouTube) ---
# YouTube chặn IP datacenter ("Sign in to confirm you're not a bot"), nên worker
# trên Modal BẮT BUỘC có proxy residential. Máy nhà thì không cần — IP nhà qua
# được, và proxy tính tiền theo GB (~50–100MB mỗi job, xem note.md).
#
# => ĐỂ TRỐNG trong .env.local. Biến này chỉ sống trong secret `opencmo-proxy`
#    của Modal, KHÔNG nằm trong secret `opencmo` (tạo từ .env.local bằng
#    --from-dotenv). Nằm ở cả hai thì khó biết worker đang dùng giá trị nào.
#
#   modal secret create opencmo-proxy --force \
#     'OPENCMO_PROXY=http://USER:PASS_country-us_session-XXXXXXXX_lifetime-10m@geo.iproyal.com:12321'
#
# Phần sau mật khẩu là cấu hình của IPRoyal:
#   _country-us          IP Mỹ
#   _session-XXXXXXXX    8 ký tự chữ/số — giữ nguyên = giữ nguyên IP (sticky)
#   _lifetime-10m        giữ IP tối đa 10 phút
# Sticky là BẮT BUỘC: link video YouTube ký kèm IP, lấy link bằng IP này rồi tải
# bằng IP khác ("Randomize IP") thì ra 403.
# OPENCMO_PROXY=

# Cookie YouTube — KHÔNG dùng cho production: gắn với một tài khoản Google thật,
# chạy trên IP datacenter thì bị đánh dấu rất nhanh.
# OPENCMO_COOKIES=/path/to/cookies.txt

