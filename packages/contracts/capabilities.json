{
  "$schema": "./capabilities.schema.json",
  "$comment": "The capability registry (docs/architecture/brain.md §7, P2 F1). Tools stay where they are; this only lists them. CMO job credits match cmo_job_price in SQL; the Studio adapter entries (studio_*, build_video, cut_shorts, mark_finished, render_short, build_slideshow, build_post_image) match STUDIO_ACCESS in apps/web/lib/departments/studio/types.ts; the priced Studio tools match MCP's PRICED set. check:contracts (apps/web/lib/cmo/capabilities.check.ts) holds all three and the caller paths.",
  "capabilities": [
    {"name": "onboard", "department": "brain", "effect": "write", "approval": "none", "callers": ["ui"], "order_kind": null, "max_steps": 10, "credits": 0, "input": "OnboardInput"},
    {"name": "plan_week", "department": "brain", "effect": "spend", "approval": "founder", "callers": ["brain", "assistant", "mcp", "ui"], "order_kind": "plan_week", "max_steps": 10, "credits": 1, "input": "PlanWeekInput"},
    {"name": "post_draft", "department": "writer", "effect": "spend", "approval": "founder", "callers": ["brain", "assistant", "mcp", "ui"], "order_kind": "post_draft", "max_steps": 12, "credits": 1, "input": "DraftPostInput"},
    {"name": "sales_scan", "department": "sales", "effect": "spend", "approval": "founder", "callers": ["brain", "assistant", "mcp", "ui"], "order_kind": "sales_scan", "max_steps": 30, "credits": 5, "input": "SalesScanInput"},
    {"name": "competitor_research", "department": "research", "effect": "spend", "approval": "none", "callers": ["brain", "assistant", "mcp"], "order_kind": "competitor_research", "max_steps": 15, "credits": 2, "input": "CompetitorResearchInput"},
    {"name": "niche_video_research", "department": "research", "effect": "spend", "approval": "none", "callers": ["brain"], "order_kind": "niche_video_research", "max_steps": 10, "credits": 2, "input": "NicheVideoResearchInput", "$comment": "P5 A2: the week plan orders it when it has a new video item; that week's video briefs wait on it and cite its URLs (SQL work_orders_brief_rules)."},
    {"name": "pull_metrics", "department": "research", "effect": "read", "approval": "none", "callers": ["brain"], "order_kind": "pull_metrics", "max_steps": 10, "credits": 0, "input": "PullMetricsInput"},
    {"name": "summarize_memory", "department": "brain", "effect": "write", "approval": "none", "callers": ["brain"], "order_kind": "summarize_memory", "max_steps": 10, "credits": 0, "input": "SummarizeMemoryInput"},
    {"name": "review_week", "department": "research", "effect": "write", "approval": "founder", "callers": ["brain"], "order_kind": "review_week", "max_steps": 10, "credits": 0, "input": "ReviewWeekInput"},
    {"name": "write_video_brief", "department": "writer", "effect": "spend", "approval": "none", "callers": ["brain"], "order_kind": "write_video_brief", "max_steps": 8, "credits": 1, "input": "WriterBrief<video_brief>", "$comment": "P3 A2: a video item of the week plan orders it; Studio's build_video order waits on it and takes output.brief (SQL work_orders_brief_rules)."},
    {"name": "write_caption", "department": "writer", "effect": "spend", "approval": "none", "callers": ["brain"], "order_kind": "write_caption", "max_steps": 30, "credits": 1, "input": "WriterBrief<caption | youtube>", "$comment": "P3 A2: a finished-video or shorts card orders it (SQL approvals_caption_rules); Writer saves each caption with cmo_save_caption and the founder approves them with the card."},
    {"name": "write_slides", "department": "writer", "effect": "spend", "approval": "none", "callers": ["brain"], "order_kind": "write_slides", "max_steps": 8, "credits": 1, "input": "WriterBrief<slides>", "$comment": "P3 F9: registered for the Slideshow squad (S3, P5), which orders it."},
    {"name": "publish_post", "department": "publish", "effect": "outbound", "approval": "founder", "callers": ["brain"], "order_kind": "publish_post", "max_steps": 4, "credits": 0, "input": "PublishPostInput", "$comment": "P4 A2: SQL's schedule_claim_due (Modal's sweep, every minute) orders it for a due slot whose schedule card the founder approved; the handler (B3) re-checks the card through publish_slot_start before posting through the publish adapter."},
    {"department": "studio", "name": "studio_plan", "effect": "read", "approval": "none", "callers": ["brain", "assistant", "mcp"], "order_kind": null, "max_steps": 1, "credits": 0, "input": "StudioTool + input", "$comment": "Prices a Studio tool; nothing is spent or stored."},
    {"department": "studio", "name": "studio_decide", "effect": "spend", "approval": "price", "callers": ["brain", "assistant", "mcp", "ui"], "order_kind": null, "max_steps": 1, "credits": "quote", "input": "StepRef + StudioAction", "$comment": "Runs, cancels or redoes a planned step once its card or signed code approves it."},
    {"department": "studio", "name": "build_video", "effect": "spend", "approval": "price", "callers": ["brain"], "order_kind": "build_video", "max_steps": 40, "credits": "quote", "input": "VideoBrief", "$comment": "The cards quote the media; the Director's tokens are charged to the order (studio_record_usage)."},
    {"department": "studio", "name": "cut_shorts", "effect": "spend", "approval": "founder", "callers": ["brain", "ui"], "order_kind": "cut_shorts", "max_steps": 20, "credits": "usage", "input": "clipId", "$comment": "Only from an edit marked finished, at most 10 a day; the Shorts squad generates nothing, its Clip editor's tokens are charged to the order (studio_record_usage)."},
    {"department": "studio", "name": "mark_finished", "effect": "write", "approval": "none", "callers": ["ui"], "order_kind": null, "max_steps": 1, "credits": 0, "input": "clipId + documentHash"},
    {"department": "studio", "name": "build_slideshow", "effect": "write", "approval": "founder", "callers": ["brain"], "order_kind": "build_slideshow", "max_steps": 10, "credits": 0, "input": "SlideshowBrief", "$comment": "P5 B3: the squad generates nothing (owner, 2026-10-30); screenshots, captured pages and the Brand Kit only."},
    {"department": "studio", "name": "build_post_image", "effect": "write", "approval": "none", "callers": ["brain"], "order_kind": "build_post_image", "max_steps": 10, "credits": 0, "input": "PostImageBrief", "$comment": "P5 B4: generates nothing; a frame, a captured page or the Brand Kit. The founder sees the image on its post's card."},
    {"department": "studio", "name": "render_short", "effect": "write", "approval": "none", "callers": ["brain"], "order_kind": "cut_shorts", "max_steps": 1, "credits": 0, "input": "shortClipId"},
    {"department": "studio", "name": "generate_media", "effect": "spend", "approval": "price", "callers": ["assistant", "mcp"], "order_kind": null, "max_steps": 1, "credits": "quote", "input": "GenerateMediaInput"},
    {"department": "studio", "name": "add_voiceover", "effect": "spend", "approval": "price", "callers": ["assistant", "mcp"], "order_kind": null, "max_steps": 1, "credits": "quote", "input": "AddVoiceoverInput"},
    {"department": "studio", "name": "replace_background", "effect": "spend", "approval": "price", "callers": ["assistant", "mcp"], "order_kind": null, "max_steps": 1, "credits": "quote", "input": "ReplaceBackgroundInput"},
    {"department": "studio", "name": "create_video", "effect": "spend", "approval": "price", "callers": ["brain", "assistant", "mcp"], "order_kind": "build_video", "max_steps": 1, "credits": "quote", "input": "CreateVideoInput"},
    {"department": "studio", "name": "animate_video", "effect": "spend", "approval": "price", "callers": ["brain", "assistant", "mcp"], "order_kind": "build_video", "max_steps": 1, "credits": "quote", "input": "AnimateVideoInput"},
    {"department": "studio", "name": "redo_keyframe", "effect": "spend", "approval": "price", "callers": ["brain", "assistant", "mcp"], "order_kind": "build_video", "max_steps": 1, "credits": "quote", "input": "RedoKeyframeInput"},
    {"department": "studio", "name": "edit_video", "effect": "spend", "approval": "price", "callers": ["assistant", "mcp"], "order_kind": null, "max_steps": 1, "credits": "quote", "input": "EditVideoInput"},
    {"department": "studio", "name": "add_explainer", "effect": "spend", "approval": "price", "callers": ["assistant", "mcp"], "order_kind": null, "max_steps": 1, "credits": "quote", "input": "AddExplainerInput"},
    {"department": "studio", "name": "plan_video", "effect": "spend", "approval": "price", "callers": ["assistant", "mcp"], "order_kind": null, "max_steps": 1, "credits": "quote", "input": "IntroSpec"},
    {"department": "studio", "name": "request_export", "effect": "spend", "approval": "price", "callers": ["assistant", "mcp"], "order_kind": null, "max_steps": 1, "credits": "quote", "input": "RequestExportInput"},
    {"department": "studio", "name": "add_captions", "effect": "spend", "approval": "price", "callers": ["assistant", "mcp"], "order_kind": null, "max_steps": 1, "credits": "quote", "input": "AddCaptionsInput"},
    {"department": "studio", "name": "translate_captions", "effect": "spend", "approval": "price", "callers": ["assistant", "mcp"], "order_kind": null, "max_steps": 1, "credits": "quote", "input": "TranslateCaptionsInput"}
  ]
}
