# Supabase — auth + Postgres + storage (một nhà cung cấp cho cả ba)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở webhook và cron. KHÔNG BAO GIỜ import vào component phía client.
SUPABASE_SERVICE_ROLE_KEY=

# URL công khai của site — magic link quay về đây sau khi bấm.
# Thiếu biến này thì link trong email trỏ về localhost ngay cả trên production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modal — worker Python chạy engine. Không gom vào Supabase/Vercel được:
# Deno của Supabase Edge Functions chặn subprocess nên ffmpeg không chạy được.
# Xem COSTS.md §4.
#
# URL lấy từ output của `modal deploy packages/engine/modal_app.py`
# (dòng endpoint của hàm `submit`). Token phải TRÙNG với OPENCMO_WORKER_TOKEN
# trong secret `opencmo` của Modal.
MODAL_SUBMIT_URL=
OPENCMO_WORKER_TOKEN=

# Polar — merchant of record, tự lo VAT.
#
# CHỈ `POLAR_WEBHOOK_SECRET` là bí mật. Hai `POLAR_CHECKOUT_*` là URL trang
# thanh toán công khai — chúng được render thẳng vào `href` ở trang billing, nên
# đừng coi chúng là khoá và cũng đừng đặt `NEXT_PUBLIC_` cho chúng: cả file này
# đọc ở phía server.
POLAR_WEBHOOK_SECRET=
POLAR_CHECKOUT_STARTER=
POLAR_CHECKOUT_CREATOR=
# Map product id -> gói. Lấy ở dashboard Polar sau khi tạo sản phẩm.
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_CREATOR=

# Cron routes (/api/cron/*, /api/internal/cmo/run). Modal is the only scheduler and sends
# Authorization: Bearer <this value>; set the same value in the Modal secret `opencmo`,
# together with OPENCMO_WEB_URL (this app's production URL).
CRON_SECRET=

# Sentry — bỏ trống thì tắt hẳn, không cần gỡ code.
NEXT_PUBLIC_SENTRY_DSN=

# Đăng nhập chỉ bằng Google: Client ID/Secret đặt trong Supabase Dashboard →
# Authentication → Providers → Google, không ở đây. Local: xem supabase/config.toml.

# ---------------------------------------------------------------- Local stack
#
# `supabase start` ở repository root dựng đủ db + auth + storage + inbucket.
# Khoá anon/service in ra bởi:
#
#     supabase status -o env
#
# Không chép khoá vào file này — .env.example nằm trong git. Khoá local là khoá
# demo cố định của Supabase CLI, nhưng chép chúng vào repo tạo thói quen sai.
#
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY của supabase status>
#   SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY của supabase status>
#   NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
#
# Magic link không gửi ra ngoài khi chạy local: mở Inbucket ở
# http://127.0.0.1:54324 để bấm link.
#
# CHỜ BẠN — giới hạn file trên cloud: config.toml để `file_size_limit = "2GiB"`
# cho local, nhưng trần THẬT trên cloud là min(bucket, toàn dự án) và gói Free
# kẹp toàn dự án ở 50 MB mỗi file (docs Supabase, "Storage > Limits > Global
# file size"). Upload video dài trên cloud cần gói Pro. Xem COSTS.md.

# ---------------------------------------------------------------- Assistant
# Khoá Anthropic cho tab Assistant (spec AI Studio §6). Thiếu thì panel nói
# "not available" và route trả 503 — không có gì khác hỏng.
#   ANTHROPIC_API_KEY=
#
# W4 quét Reddit (tầng CMO, Reddit Agent) đọc qua ScrapeCreators. Thiếu thì nút
# Run now của Reddit Agent tắt và API trả 503 TRƯỚC khi giữ credit.
#   SCRAPECREATORS_API_KEY=
#
# Claude GIẢ (kịch bản cố định) cho check:api và E2E, không tốn tiền. Bị bỏ
# qua trên production (VERCEL_ENV=production) dù có đặt.
#   OPENCMO_AGENT_FAKE=1
#
# Generate (AI Studio P5): model giả trong packages/contracts/ai-models.json
# (ảnh màu có chữ prompt, test pattern, tiếng sine, tiếng ồn — ffmpeg, không tốn
# tiền). PHẢI đặt ở CẢ Next lẫn worker; bị bỏ qua trên production. Chưa có
# provider thật nào (P6–P8), nên không đặt thì panel Generate không hiện.
#   OPENCMO_AI_FAKE=1
#
# The editor Assistant runs on Claude (ANTHROPIC_API_KEY, lib/agent/model.ts). AI media goes
# through fal; moderation uses Claude Haiku plus fal's image safety check, so production turns AI
# images/video off when either key is missing. Same keys as the engine:
#   FAL_KEY=
#   ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Agent CMO (H1)
# Every CMO job is an agent with its own model and key (lib/cmo/agents/registry.ts). All agents
# run on Claude with ANTHROPIC_API_KEY: Opus for drafting agents, Haiku for checking agents.
# Override one agent with env, no code change:
#   CMO_AGENT_<ID>_MODEL=<Claude model id>   # the chat agent (CMO) must match agent_model_prices
#   CMO_AGENT_<ID>_API_KEY=<own key>          # defaults to ANTHROPIC_API_KEY
# <ID>: CMO (chat), ONBOARDING (W0), PLANNER (W1), X_WRITER (W2), SALES (W4 replies),
#       RESEARCH (W7), VIDEO (W5 captions), CHECKER (scoring/checks), CAPTIONS (editor translation).
