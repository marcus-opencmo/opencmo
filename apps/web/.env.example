# Supabase — auth + Postgres + storage (một nhà cung cấp cho cả ba)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở webhook và cron. KHÔNG BAO GIỜ import vào component phía client.
SUPABASE_SERVICE_ROLE_KEY=

# URL công khai của site — magic link quay về đây sau khi bấm.
# Thiếu biến này thì link trong email trỏ về localhost ngay cả trên production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modal — worker Python chạy engine. Không gom vào Supabase/Vercel được:
# Deno của Supabase Edge Functions chặn subprocess nên ffmpeg không chạy được.
# Xem COSTS.md §4.
#
# URL lấy từ output của `modal deploy packages/engine/modal_app.py`
# (dòng endpoint của hàm `submit`). Token phải TRÙNG với OPENCMO_WORKER_TOKEN
# trong secret `opencmo` của Modal.
MODAL_SUBMIT_URL=
OPENCMO_WORKER_TOKEN=
# Servers that must not hold the worker token (the MCP server on Modal) wake the worker through its
# `wake` endpoint instead: URL from `modal deploy`, token equal to OPENCMO_WAKE_TOKEN in `opencmo`.
OPENCMO_WAKE_URL=
OPENCMO_WAKE_TOKEN=

# Polar — merchant of record, tự lo VAT.
#
# CHỈ `POLAR_WEBHOOK_SECRET` là bí mật. Hai `POLAR_CHECKOUT_*` là URL trang
# thanh toán công khai — chúng được render thẳng vào `href` ở trang billing, nên
# đừng coi chúng là khoá và cũng đừng đặt `NEXT_PUBLIC_` cho chúng: cả file này
# đọc ở phía server.
POLAR_WEBHOOK_SECRET=
POLAR_CHECKOUT_STARTER=
POLAR_CHECKOUT_CREATOR=
# Map product id -> gói. Lấy ở dashboard Polar sau khi tạo sản phẩm.
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_CREATOR=

# Cron routes (/api/cron/*, /api/internal/cmo/run). Modal is the only scheduler and sends
# Authorization: Bearer <this value>; set the same value in the Modal secret `opencmo`,
# together with OPENCMO_WEB_URL (this app's production URL).
CRON_SECRET=
# /api/cron/cleanup only (it deletes unpaid accounts): its own value, also in the Modal secret `opencmo`.
CRON_CLEANUP_SECRET=

# Sentry — bỏ trống thì tắt hẳn, không cần gỡ code.
NEXT_PUBLIC_SENTRY_DSN=

# Đăng nhập chỉ bằng Google: Client ID/Secret đặt trong Supabase Dashboard →
# Authentication → Providers → Google, không ở đây. Local: xem supabase/config.toml.

# ---------------------------------------------------------------- Local stack
#
# `supabase start` ở repository root dựng đủ db + auth + storage + inbucket.
# Khoá anon/service in ra bởi:
#
#     supabase status -o env
#
# Không chép khoá vào file này — .env.example nằm trong git. Khoá local là khoá
# demo cố định của Supabase CLI, nhưng chép chúng vào repo tạo thói quen sai.
#
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY của supabase status>
#   SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY của supabase status>
#   NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
#
# Magic link không gửi ra ngoài khi chạy local: mở Inbucket ở
# http://127.0.0.1:54324 để bấm link.
#
# CHỜ BẠN — giới hạn file trên cloud: config.toml để `file_size_limit = "2GiB"`
# cho local, nhưng trần THẬT trên cloud là min(bucket, toàn dự án) và gói Free
# kẹp toàn dự án ở 50 MB mỗi file (docs Supabase, "Storage > Limits > Global
# file size"). Upload video dài trên cloud cần gói Pro. Xem COSTS.md.

# ---------------------------------------------------------------- Assistant
# Khoá Anthropic cho tab Assistant (spec AI Studio §6). Thiếu thì panel nói
# "not available" và route trả 503 — không có gì khác hỏng.
#   ANTHROPIC_API_KEY=
#
# W4 quét Reddit (tầng CMO, Reddit Agent) đọc qua ScrapeCreators. Thiếu thì nút
# Run now của Reddit Agent tắt và API trả 503 TRƯỚC khi giữ credit.
#   SCRAPECREATORS_API_KEY=
#
# Claude GIẢ (kịch bản cố định) cho check:api và E2E, không tốn tiền. Bị bỏ
# qua trên production (VERCEL_ENV=production) dù có đặt.
#   OPENCMO_AGENT_FAKE=1
#
# Generate (AI Studio P5): model giả trong packages/contracts/ai-models.json
# (ảnh màu có chữ prompt, test pattern, tiếng sine, tiếng ồn — ffmpeg, không tốn
# tiền). PHẢI đặt ở CẢ Next lẫn worker; bị bỏ qua trên production. Chưa có
# provider thật nào (P6–P8), nên không đặt thì panel Generate không hiện.
#   OPENCMO_AI_FAKE=1
#
# Self-hosted production (not on Vercel): set on BOTH the web app and the worker, so fake models
# and demo data stay off and missing moderation keys refuse AI media instead of skipping checks.
# On Vercel, VERCEL_ENV=production does the same.
#   OPENCMO_ENV=production
#
# Long Assistant chats: clear the oldest tool results server-side past 80k input tokens (Claude
# context editing, beta). Off until a real-model eval (npm run agent:eval) shows it pays.
#   OPENCMO_AGENT_CONTEXT_EDITING=1
#
# Load the editor Assistant's specialised tools on demand (Claude tool search): ~45 core tools stay
# in every request, the rest load when the model searches. Off until a real-model eval shows it pays.
#   OPENCMO_AGENT_TOOL_SEARCH=1
#
# The editor Assistant runs on Claude (ANTHROPIC_API_KEY, lib/agent/model.ts), or on Gemini when
# GEMINI_API_KEY is set: the panel then offers both, and new chats start on Claude unless
# OPENCMO_AGENT_PROVIDER says otherwise (or only the Gemini key is present). AI media goes
# through fal; moderation is the registry's `moderation` agent (below) on any provider with a key,
# so production turns AI images/video off when no provider can also check the drawn frames (an
# OpenAI-compatible endpoint other than Groq needs OPENCMO_MODERATION_VISION_MODEL, as on the
# worker). Same keys as the engine:
#   FAL_KEY=
#   GROQ_API_KEY=
#   OPENCMO_MODERATION_VISION_MODEL=
#   ANTHROPIC_API_KEY=
#   GEMINI_API_KEY=
#   OPENCMO_AGENT_PROVIDER=anthropic|gemini
#   AGENT_GEMINI_MODEL=gemini-pro-latest
#
# Explainers (/explain, docs/explainer-build.md): where the clip-motion renderer runs. Set on BOTH
# the web app (previews) and the worker (renders). `npm run dev` defaults to `local` and, without
# FAL_KEY, to a silent fake voice, so the whole flow runs without paid keys; the first local render
# downloads Remotion's headless browser once. Production: `modal`, with MOTION_PREVIEW_URL = the
# `motion_preview` endpoint printed by `modal deploy`, and MOTION_PREVIEW_TOKEN = the same value as in
# the `opencmo-motion` Modal secret (its own token: the container running model-written code must not
# hold one that can submit tasks).
#   OPENCMO_MOTION=local|modal
#   OPENCMO_MOTION_FAKE_VOICE=1
#   MOTION_PREVIEW_URL=
#   MOTION_PREVIEW_TOKEN=
#   OPENCMO_MOTION_SCALE=0.5          # dev only: render smaller frames, faster
# Images in explainers (kit.Image): previews download the user's library images from signed URLs, and
# only from this origin (the Supabase URL; Modal: set it in the `opencmo-motion` secret, equal to the
# worker's SUPABASE_URL), then encode them like a final render. Final renders get the images inlined
# by the worker and need none. With OPENCMO_MOTION=local the engine does that step:
# OPENCMO_ENGINE_PYTHON is its Python (default packages/engine/.venv312/bin/python; dev.mjs sets it).
#   OPENCMO_MOTION_ASSET_ORIGIN=http://127.0.0.1:54321
#   OPENCMO_ENGINE_PYTHON=/path/to/packages/engine/.venv312/bin/python

# ---------------------------------------------------------------- Agent CMO (H1)
# Every CMO job is an agent with its own model and key (lib/cmo/agents/registry.ts). Agents run on
# the first provider of CMO_LLM_PROVIDERS (default openai,anthropic,gemini) the server has a key
# for, and fail over to the next: `openai` is any OpenAI-compatible API, Groq unless
# OPENAI_COMPAT_BASE_URL says otherwise (GROQ_API_KEY goes only to Groq, OPENAI_COMPAT_API_KEY only to
# OPENAI_COMPAT_BASE_URL; OPENAI_COMPAT_MODEL and OPENAI_COMPAT_CHECK_MODEL for the two tiers); Claude uses ANTHROPIC_API_KEY (Sonnet / Haiku);
# Gemini uses GEMINI_API_KEY (Pro / Flash). Override with env, no code change:
#   CMO_LLM_PROVIDERS=openai,anthropic,gemini
#   CMO_LLM_PROVIDER=openai|groq|anthropic|gemini   # every agent, including the editor's video teams
#   CMO_AGENT_<ID>_PROVIDER=openai|groq|anthropic|gemini  # one agent
#   CMO_AGENT_<ID>_BASE_URL=<OpenAI-compatible URL>       # openai only
#   CMO_AGENT_<ID>_MODEL=<model id>           # the chat agent (CMO) must match agent_model_prices
#   CMO_AGENT_<ID>_API_KEY=<own key>          # defaults to the provider's shared key
# <ID>: MODERATION (AI media prompts), CMO (chat), ONBOARDING (W0), PLANNER (W1), X_WRITER (W2), SALES (W4 replies),
#       RESEARCH (W7), VIDEO (W5 captions), CHECKER (scoring/checks), CAPTIONS (editor translation).

# MCP server (packages/mcp-server, deployed by packages/engine/mcp_app.py on Modal).
# OPENCMO_MCP_URL is its public URL; unset hides "Connect Claude" in the app. The other three are
# read by the MCP server itself (its Modal secret `opencmo-mcp`; locally for `npm run dev` there).
OPENCMO_MCP_URL=
# Signs MCP confirm codes; any long random value, never the JWT secret.
OPENCMO_MCP_CONFIRM_KEY=
# 1 lists voice tools without holding ELEVENLABS_API_KEY (the worker renders voice).
OPENCMO_VOICE_ENABLED=

# Reaching the founder (P6 C0, C1). Email sends through Resend only with BOTH the key and OPENCMO_EMAIL_LIVE=1;
# locally OPENCMO_DIGEST_LOCAL_MAIL=1 sends to the Supabase mail catcher (http://127.0.0.1:54324).
RESEND_API_KEY=
OPENCMO_EMAIL_LIVE=
# OPENCMO_EMAIL_FROM="OpenCMO <cmo@opencmo.io>"   # a sender on the verified domain
OPENCMO_DIGEST_LOCAL_MAIL=
# Web push: `npx web-push generate-vapid-keys` prints the pair (base64url). The public key is also sent to browsers.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@opencmo.io
